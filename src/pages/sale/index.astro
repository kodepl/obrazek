---
import Gallery from "../../layouts/Gallery.astro";
import site, { roomSlug } from "../../site.config";
---
<Gallery title="Sale" description="Działy tematyczne galerii">
  <main class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="font-display text-4xl font-semibold">Sale</h1>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {site.rooms.map((r) => (
        <a href={`/sale/${roomSlug(r.name)}/`} class="border border-frame/15 bg-mat p-6 frame-shadow hover:border-ochre/40">
          <h2 class="font-display text-2xl font-semibold text-ochre">{r.name}</h2>
          <p class="mt-2 text-sm text-hush">{r.blurb}</p>
        </a>
      ))}
    </div>
  </main>
</Gallery>
