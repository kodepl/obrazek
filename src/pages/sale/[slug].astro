---
import Gallery from "../../layouts/Gallery.astro";
import { getCollection } from "astro:content";
import site, { coverFor, roomSlug } from "../../site.config";

export async function getStaticPaths() {
  return site.rooms.map((r) => ({ params: { slug: roomSlug(r.name) }, props: { room: r } }));
}

const { room } = Astro.props;
const posts = (await getCollection("obrazy"))
  .filter((p) => p.data.category === room.name)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Gallery title={room.name} description={room.blurb}>
  <main class="mx-auto max-w-4xl px-4 py-12">
    <p class="text-[11px] uppercase tracking-[0.25em] text-ochre">Sala</p>
    <h1 class="mt-2 font-display text-4xl font-semibold">{room.name}</h1>
    <p class="mt-3 text-hush">{room.blurb}</p>
    <div class="mt-10 columns-1 gap-6 sm:columns-2">
      {posts.map((post) => (
        <article class="mb-6 break-inside-avoid">
          <a href={`/obrazy/${post.slug}/`} class="frame-shadow mat-pad block">
            <img src={coverFor(post.data.category, post.data.image)} alt="" class="aspect-wide w-full object-cover" />
          </a>
          <h2 class="mt-2 font-display text-xl font-semibold">
            <a href={`/obrazy/${post.slug}/`} class="hover:text-ochre">{post.data.title}</a>
          </h2>
        </article>
      ))}
      {posts.length === 0 && <p class="text-hush">Sala czeka na kolejne obrazy-teksty.</p>}
    </div>
  </main>
</Gallery>
