---
import Gallery from "../../layouts/Gallery.astro";
import site from "../../site.config";
---
<Gallery title="O galerii" description="Kim jesteśmy">
  <main class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="font-display text-4xl font-semibold">O galerii</h1>
    <div class="mt-8 flex gap-5 border border-frame/10 bg-mat p-6 frame-shadow">
      <img src={site.authorAvatar} alt="" class="h-24 w-24 rounded-full object-cover" />
      <div>
        <p class="font-display text-2xl">{site.author}</p>
        <p class="text-xs uppercase tracking-widest text-ochre">{site.authorRole}</p>
        <p class="mt-3 text-hush">{site.authorBio}</p>
      </div>
    </div>
    <p class="mt-8 leading-relaxed text-hush">Obrazek.info to galeria tekstów. Zamiast samego pliku JPG dostajesz kontekst: jak powstał kadr, czego szuka oko, gdzie kończy się reprodukcja a zaczyna doświadczenie.</p>
  </main>
</Gallery>
