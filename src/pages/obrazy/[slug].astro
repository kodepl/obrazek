---
import Gallery from "../../layouts/Gallery.astro";
import { getCollection } from "astro:content";
import site, { coverFor } from "../../site.config";

export async function getStaticPaths() {
  const posts = await getCollection("obrazy");
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const cover = coverFor(post.data.category, post.data.image);
const date = post.data.pubDate.toLocaleDateString("pl-PL", { day: "numeric", month: "long", year: "numeric" });
const pile = (await getCollection("obrazy")).sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
const here = pile.findIndex((p) => p.slug === post.slug);
const newer = here > 0 ? pile[here - 1] : null;
const older = here >= 0 && here < pile.length - 1 ? pile[here + 1] : null;
const also = pile.filter((p) => p.slug !== post.slug).slice(0, 3);

---
<Gallery title={post.data.title} description={post.data.description} image={cover}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-ochre">{post.data.category} · {date}</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight md:text-5xl">{post.data.title}</h1>
    <p class="mt-4 text-lg text-hush">{post.data.description}</p>
    <div class="mt-5 flex items-center gap-3 text-sm text-hush">
      <img src={site.authorAvatar} alt="" class="h-10 w-10 rounded-full object-cover" />
      <div>
        <p class="font-semibold text-slateink">{post.data.author || site.author}</p>
        <p class="text-xs">{post.data.authorBio || site.authorBio}</p>
      </div>
    </div>
    <div class="frame-shadow mat-pad mt-8">
      <img src={cover} alt="" class="aspect-wide w-full object-cover" />
    </div>
    <div class="prose prose-slate prose-headings:font-display prose-headings:font-semibold prose-a:text-ochre mt-10 max-w-none">
      <Content />
    </div>
  </article>

<section class="mx-auto max-w-3xl px-4 pb-16">
  <p class="mt-10 font-display text-2xl">Inne kadry z sali</p>
  <div class="mt-4 grid gap-4 sm:grid-cols-3">
    {also.map((item) => (
      <a href={"/obrazy/" + item.slug + "/"} class="frame-shadow block">
        <img src={item.data.image} alt="" class="aspect-wide w-full object-cover" />
        <p class="p-3 text-sm font-semibold">{item.data.title}</p>
      </a>
    ))}
  </div>
</section>
</Gallery>
