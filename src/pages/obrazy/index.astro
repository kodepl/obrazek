---
import Gallery from "../../layouts/Gallery.astro";
import { getCollection } from "astro:content";
import { coverFor } from "../../site.config";
const posts = (await getCollection("obrazy")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Gallery title="Katalog" description="Wszystkie teksty galerii Obrazek">
  <main class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="font-display text-4xl font-semibold">Katalog</h1>
    <ol class="mt-10 space-y-8">
      {posts.map((post, i) => (
        <li class="flex gap-5 border-b border-frame/10 pb-6">
          <span class="font-display text-2xl text-ochre">{String(i + 1).padStart(2, "0")}</span>
          <a href={`/obrazy/${post.slug}/`} class="frame-shadow mat-pad shrink-0">
            <img src={coverFor(post.data.category, post.data.image)} alt="" class="h-20 w-16 object-cover" />
          </a>
          <div>
            <p class="text-[11px] uppercase tracking-widest text-hush">{post.data.category}</p>
            <a href={`/obrazy/${post.slug}/`} class="font-display text-2xl font-semibold hover:text-ochre">{post.data.title}</a>
            <p class="mt-1 text-sm text-hush">{post.data.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </main>
</Gallery>
